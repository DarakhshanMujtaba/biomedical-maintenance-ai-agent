        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"request\": \"Show me all ICU equipment that needs maintenance within the next 30 days, prioritize it, schedule the top 5, notify the team, and generate this month's report.\"\n}\n",
