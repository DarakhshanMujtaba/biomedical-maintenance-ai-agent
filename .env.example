# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# LLM (free tier): https://console.groq.com/keys
GROQ_API_KEY=
CREWAI_TRACING_ENABLED=false

# E-mail sent ONLY after someone clicks Approve on the dashboard.
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16 characters below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=
MAIL_FROM=your.address@gmail.com
# Who receives the approved schedule (comma-separated)
TEAM_EMAILS=teammate1@example.com,teammate2@example.com

# Time zone for maintenance slots (optional)
SCHEDULE_TIMEZONE=Asia/Karachi
